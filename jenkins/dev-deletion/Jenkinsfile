pipeline{
    agent {
       label "aws-jenkins-slave"
    }
    parameters {
        string(name: 'NAME', defaultValue: 'demo-env', description: 'Environment name to tear down')
    }
    stages{
        stage('RDS-DB-deletion') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'RDS_PASSWORD', usernameVariable: 'RDS_USERNAME'),
                    usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')
                    ]) {
                    echo "[RDS] Starting database teardown."
                    sh '''#!/bin/bash
                        echo "[RDS] Destroying RDS resources via Terraform..."
                        cd terraform/RDS
                        envsubst < backend.conf | cat - > test.conf
                        cat test.conf > backend.conf
                        terraform init -backend-config=backend.conf
                        terraform fmt -check
                        terraform destroy -input=false -var-file staging.tfvars -var "name=${NAME}" -auto-approve
                        echo "[RDS] RDS resources deleted successfully."
                    '''
                }
            }
        }
        stage('Backend-deletion') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                    sh '''#!/bin/bash
                        echo "[Backend] Starting backend teardown."

                        echo "[Backend] Deregistering AMI..."
                        AMI_ID=$(aws ec2 describe-images --region us-east-1 --filters Name=name,Values=${NAME} | jq '.Images[0].ImageId' | sed 's/"//g')
                        SNAPSHOT_ID=$(aws ec2 describe-images --image-ids $AMI_ID --query 'Images[0].BlockDeviceMappings[0].Ebs.SnapshotId' --output text --region us-east-1)
                        aws ec2 deregister-image --image-id $AMI_ID --region us-east-1
                        echo "[Backend] AMI deregistered."
                        echo "[Backend] Deleting snapshot..."
                        aws ec2 delete-snapshot --snapshot-id $SNAPSHOT_ID --region us-east-1
                        echo "[Backend] Snapshot deleted."
                        cd terraform/EC2-S3
                        envsubst < backend.conf | cat - > test.conf
                        cat test.conf > backend.conf
                        terraform init -backend-config=backend.conf
                        terraform fmt -check
                        terraform destroy -input=false -var-file staging.tfvars -var "name=${NAME}" -var="image_id=${AMI_ID}" -auto-approve
                        echo "[Backend] Backend infrastructure deleted successfully."
                    '''
                }
            }
        }
        stage('Remove Environment from DynamoDB') {
            steps {
                script {
                    def environmentName = env.NAME

                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh "aws dynamodb delete-item --table-name environments --region us-east-1 --key '{\"Name\": {\"S\": \"${environmentName}\"}}'"
                    }
                    echo "[DynamoDB] Removed environment '${environmentName}'."
                }
            }
        }
    }
    post { 
        always { 
            cleanWs()
        }
    }
}
