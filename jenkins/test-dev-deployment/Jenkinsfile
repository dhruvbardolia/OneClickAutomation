        stage('Register Job in S3') {
            steps {
                script {
                    echo "S3 Registering..."
                    def jobName = NAME
                    def s3Bucket = "live-env.woliba.io"
                    def fileName = "index.html"
                    def tempFile = "temp.txt"
                    echo "mayr"

                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh "aws s3 cp s3://${s3Bucket}/${fileName} ${tempFile} || touch ${tempFile}"
                        sh "echo ${jobName} >> ${tempFile}"
                        sh "aws s3 cp ${tempFile} s3://${s3Bucket}/${fileName}"
                        sh "rm ${tempFile}"
                    }
                    echo "mayurr-test"
                }
            }
        }
        stage('Store Environment Name in DynamoDB') {
            steps {
                script {
                    def environmentName = env.NAME

                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh "aws dynamodb put-item --table-name environments --item '{\"Name\": {\"S\": \"${environmentName}\"}}'"
                    }
                    echo "Stored environment name '${environmentName}' in DynamoDB."
                }
            }
        }

