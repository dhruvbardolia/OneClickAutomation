pipeline{
    agent {
       label "aws-jenkins-slave"
    }
    stages{
        stage('RDS-DB-Creation') {
            steps {
                script {
                    if (params.RDS_ENDPOINT == 'Prod') {
                        withCredentials([
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_PASSWORD', usernameVariable: 'DB_USERNAME'),
                            string(credentialsId: 'USER_PASSWORD', variable: 'USER_PASSWORD'),
                            ]) {
                            echo "RDS-DB-Creation"
                            sh '''#!/bin/bash
                                echo "RDS Creation..."
                                git clone https://${USERNAME}:${PASSWORD}@github.com/TrainingAmigo/woliba-infra.git
                                cd woliba-infra/terraform/RDS
                                envsubst < s3-bucket.conf | cat - > test.conf
                                cat test.conf > s3-bucket.conf
                                terraform init -backend-config=s3-bucket.conf
                                terraform fmt -check
                                terraform plan -input=false -var-file staging.tfvars -out ${NAME}.tfplan -lock=false -var="name=${NAME}"
                                terraform apply -input=false -lock=false "${NAME}.tfplan"
                                export RDS_NAME=$(terraform output -raw rds_name)
                                export ENDPOINT=$(aws rds describe-db-instances --db-instance-identifier $RDS_NAME --query "*[].[Endpoint.Address]" | grep '"' | cut -d '"' -f 2)
                                echo $RDS_NAME
                                echo $ENDPOINT
                                sleep 15
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -D trainingamigo -e "SHOW DATABASES;"
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -D trainingamigo -e "USE trainingamigo; UPDATE users SET password = '${USER_PASSWORD}';"
                                echo "RDS Creation successfull..."
                            '''
                        }
                    } 
                    else {
                        withCredentials([
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_PASSWORD', usernameVariable: 'DB_USERNAME'),
                            string(credentialsId: 'USER_PASSWORD', variable: 'USER_PASSWORD'),
                            ]) {
                            echo "RDS-DEV-DB"
                            sh '''#!/bin/bash
                                echo "Fetching the RDS..."
                                git clone https://${USERNAME}:${PASSWORD}@github.com/TrainingAmigo/woliba-infra.git
                                export ENDPOINT=""
                                echo $ENDPOINT
                                sleep 15
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -D trainingamigo -e "SHOW DATABASES;"
                                echo "RDS Connection is success..."
                            '''
                        }
                    }
                }
            }
        }
