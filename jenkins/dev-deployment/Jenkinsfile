pipeline{
    agent {
       label "aws-jenkins-slave"
    }
    parameters {
        choice(name: 'RDS_ENDPOINT', choices: ['Production', 'Development'], description: 'Select which RDS endpoint to use')
        string(name: 'NAME', defaultValue: 'demo-env', description: 'Environment name used across Terraform, Packer, and DynamoDB')
        string(name: 'BE_BRANCH_NAME', defaultValue: 'main', description: 'Backend branch to build into the AMI')
        string(name: 'FE_BRANCH_NAME', defaultValue: 'main', description: 'Frontend branch to build before uploading to S3')
    }
    stages{
        stage('Database Creation') {
            steps {
                script {
                    if (params.RDS_ENDPOINT == 'Production') {
                        withCredentials([
                            // Github credentials from Jenkins Credentials
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            // RDS credentials from Jenkins Credentials
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_PASSWORD', usernameVariable: 'DB_USERNAME'),
                            string(credentialsId: 'USER_PASSWORD', variable: 'USER_PASSWORD'),
                            ]) {
                            echo "[Database] Starting database creation."
                            sh '''#!/bin/bash
                                echo "[Database] Provisioning RDS instance..."
                                git clone https://${USERNAME}:${PASSWORD}@github.com/dhruvbardolia/dhruv-infra.git
                                cd dhruv-infra/terraform/RDS
                                export NAME=${NAME}
                                export bucket=terraform-backend-dhruv
                                export region=us-east-1 # Region for your infrastructure
                                envsubst < backend.conf | cat - > test.conf
                                cat test.conf > backend.conf
                                terraform init -backend-config=backend.conf
                                terraform fmt -check
                                terraform plan -input=false -var-file staging.tfvars -out ${NAME}.tfplan -lock=false -var="name=${NAME}"
                                terraform apply -input=false -lock=false "${NAME}.tfplan"
                                export RDS_NAME=$(terraform output -raw rds_name)
                                export ENDPOINT=$(aws rds describe-db-instances --db-instance-identifier $RDS_NAME --region us-east-1 --query "*[].[Endpoint.Address]" | grep '"' | cut -d '"' -f 2)
                                echo "[Database] RDS instance: $RDS_NAME"
                                echo "[Database] Endpoint: $ENDPOINT"
                                sleep 15
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -D dhruvbardolia -e "USE dhruvbardolia; UPDATE users SET mail = CONCAT('dhruv-user-', uid, '@dhruv.io') where mail != 'superteam@dhruv.io';"
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -D dhruvbardolia -e "USE dhruvbardolia; UPDATE users SET password = '${USER_PASSWORD}';"
                                echo "[Database] RDS creation completed successfully."
                            '''
                        }
                    } 
                    else {
                        withCredentials([
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_PASSWORD', usernameVariable: 'DB_USERNAME'),
                            string(credentialsId: 'USER_PASSWORD', variable: 'USER_PASSWORD'),
                            ]) {
                            echo "[Database] Using existing development RDS instance."
                            sh '''#!/bin/bash
                                echo "[Database] Fetching RDS endpoint details..."
                                export ENDPOINT="dhruvbardolia-dev.xyz.us-east-1.rds.amazonaws.com"
                                echo "[Database] Endpoint: $ENDPOINT"
                                sleep 15
                                mysql -h $ENDPOINT -u ${DB_USERNAME} -p${DB_PASSWORD} -e "SHOW DATABASES;"
                                echo "[Database] Verified connectivity to development RDS."
                            '''
                        }
                    }
                }
            }
        }
        stage('Backend-Deployment-with-s3') {
            steps {
                script {
                    if (params.RDS_ENDPOINT == 'Production') {
                        withCredentials([
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_dhruvbardolia_PASSWORD', usernameVariable: 'DB_dhruvbardolia_USERNAME'),
                            string(credentialsId: 'APP_KEY', variable: 'APP_KEY'),
                            string(credentialsId: 'DB_HOST', variable: 'DB_HOST'),
                            string(credentialsId: 'SPARKPOST_SECRET', variable: 'SPARKPOST_SECRET'),
                            string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                            string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                            string(credentialsId: 'BUGSNAG_API_KEY', variable: 'BUGSNAG_API_KEY'),
                            string(credentialsId: 'FCM_SERVER_KEY', variable: 'FCM_SERVER_KEY'),
                            string(credentialsId: 'STRIPE_KEY', variable: 'STRIPE_KEY'),
                            string(credentialsId: 'STRIPE_SECRET', variable: 'STRIPE_SECRET'),
                            
                            ]) {
                            echo "[Backend] Starting backend deployment (Production)."
                            sh '''#!/bin/bash

                                echo "[Backend] Building AMI with Packer..."
                                export DIR=$(pwd)
                                cd $DIR
                                cd terraform/RDS
                                envsubst < backend.conf | cat - > test.conf
                                cat test.conf > backend.conf
                                terraform init -backend-config=backend.conf
                                export RDS_NAME=$(terraform output -raw rds_name)
                                echo "[Backend] Resolved production RDS instance: $RDS_NAME"
                                export ENDPOINT=$(aws rds describe-db-instances --db-instance-identifier $RDS_NAME --region us-east-1 --query "*[].[Endpoint.Address]" | grep '"' | cut -d '"' -f 2)
                                echo "[Backend] Production RDS endpoint: $ENDPOINT"
                                cd $DIR
                                cd packer
                                packer init .
                                packer build -var "AMI_NAME=${NAME}" -var "BE_BRANCH_NAME=${BE_BRANCH_NAME}" -var "APP_KEY=${APP_KEY}" -var "APP_URL=http://localhost" -var "DB_HOST=$ENDPOINT" -var "DB_NAME=dhruvbardolia" -var "DB_USERNAME=${DB_dhruvbardolia_USERNAME}" -var "DB_PASSWORD=${DB_dhruvbardolia_PASSWORD}" -var "SPARKPOST_SECRET=${SPARKPOST_SECRET}" -var "AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}" -var "AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}" -var "BUGSNAG_API_KEY=${BUGSNAG_API_KEY}" -var "FCM_SERVER_KEY=${FCM_SERVER_KEY}" -var "STRIPE_KEY=${STRIPE_KEY}" -var "STRIPE_SECRET=${STRIPE_SECRET}" build.pkr.hcl
                                AMI_ID=$(jq -r '.builds[-1].artifact_id' manifest.json | cut -d ":" -f2)
                                echo "[Backend] Created AMI: $AMI_ID"

                                echo "[Backend] Applying Terraform for backend infrastructure..."
                                cd ..
                                cd terraform/EC2-S3
                                envsubst < backend.conf | cat - > test.conf
                                cat test.conf > backend.conf
                                terraform init -backend-config=backend.conf
                                terraform fmt -check
                                terraform plan -input=false -var-file staging.tfvars -out ${NAME}.tfplan -lock=false -var="name=${NAME}" -var="image_id=$AMI_ID"
                                terraform apply -input=false -lock=false "${NAME}.tfplan"
                                echo "[Backend] Backend public IP: $BACKEND_PUBLIC_IP"
                                echo "[Backend] Backend deployment completed successfully."
                            '''
                        }
                    }
                    else {
                        withCredentials([
                            usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME'),
                            usernamePassword(credentialsId: 'rds-credentials', passwordVariable: 'DB_dhruvbardolia_PASSWORD', usernameVariable: 'DB_dhruvbardolia_USERNAME'),
                            string(credentialsId: 'APP_KEY', variable: 'APP_KEY'),
                            string(credentialsId: 'DB_HOST', variable: 'DB_HOST'),
                            string(credentialsId: 'SPARKPOST_SECRET', variable: 'SPARKPOST_SECRET'),
                            string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                            string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                            string(credentialsId: 'BUGSNAG_API_KEY', variable: 'BUGSNAG_API_KEY'),
                            string(credentialsId: 'FCM_SERVER_KEY', variable: 'FCM_SERVER_KEY'),
                            string(credentialsId: 'STRIPE_KEY', variable: 'STRIPE_KEY'),
                            string(credentialsId: 'STRIPE_SECRET', variable: 'STRIPE_SECRET'),
                            
                            ]) {
                            echo "[Backend] Starting backend deployment (Development)."
                            sh '''#!/bin/bash

                                echo "[Backend] Building AMI with Packer..."
                                git clone https://${USERNAME}:${PASSWORD}@github.com/dhruvbardolia/dhruv-infra.git
                                export DIR=$(pwd)
                                export ENDPOINT="dhruvbardolia-dev.c5ag8ujkoc4k.us-east-1.rds.amazonaws.com"
                                echo "[Backend] Development RDS endpoint: $ENDPOINT"
                                cd $DIR
                                cd packer
                                packer init .
                                packer build -var "AMI_NAME=${NAME}" -var "BE_BRANCH_NAME=${BE_BRANCH_NAME}" -var "APP_KEY=${APP_KEY}" -var "APP_URL=http://localhost" -var "DB_HOST=$ENDPOINT" -var "DB_NAME=dhruvbardolia" -var "DB_USERNAME=${DB_dhruvbardolia_USERNAME}" -var "DB_PASSWORD=${DB_dhruvbardolia_PASSWORD}" -var "SPARKPOST_SECRET=${SPARKPOST_SECRET}" -var "AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}" -var "AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}" -var "BUGSNAG_API_KEY=${BUGSNAG_API_KEY}" -var "FCM_SERVER_KEY=${FCM_SERVER_KEY}" -var "STRIPE_KEY=${STRIPE_KEY}" -var "STRIPE_SECRET=${STRIPE_SECRET}" build.pkr.hcl
                                AMI_ID=$(jq -r '.builds[-1].artifact_id' manifest.json | cut -d ":" -f2)
                                echo "[Backend] Created AMI: $AMI_ID"

                                echo "[Backend] Applying Terraform for backend infrastructure..."
                                cd ..
                                cd terraform/EC2-S3
                                envsubst < backend.conf | cat - > test.conf
                                cat test.conf > backend.conf
                                terraform init -backend-config=backend.conf
                                terraform fmt -check
                                terraform plan -input=false -var-file staging.tfvars -out ${NAME}.tfplan -lock=false -var="name=${NAME}" -var="image_id=$AMI_ID"
                                terraform apply -input=false -lock=false "${NAME}.tfplan"
                                echo "[Backend] Backend public IP: $BACKEND_PUBLIC_IP"
                                echo "[Backend] Backend deployment completed successfully."
                            '''
                        }
                    }
                }
            }
        }
        stage('Frontend-Deployment') {
            agent{
                    docker{
                            // Pull the Docker image
                        image 'dhruvbardolia/node-aws-terraform:v4'
                        args '-u root'
                    }
                }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME')]) {
                    sh '''#!/bin/bash
                        echo "[Frontend] Starting build process..."

                        export NAME=${NAME}
                        export DIR=$(pwd)
                        cd terraform/EC2-S3
                        envsubst < backend.conf | cat - > test.conf
                        cat test.conf > backend.conf
                        terraform init -backend-config=backend.conf
                        export S3_NAME=$(terraform output -raw s3_name)
                        export BACKEND_PUBLIC_IP=$(terraform output -raw public_ip)

                        export API_URL=http://$BACKEND_PUBLIC_IP
                        cd $DIR
                        git clone https://${USERNAME}:${PASSWORD}@github.com/react.git
                        cd react
                        #Checkout the branch based on a parameter
                        git checkout ${FE_BRANCH_NAME}
                        
                        # Append to the .env file
                        envsubst < .env | cat - > .env.test
                        cat .env.test > .env
                        cat .env
                        
                        # Install project dependencbackend.confies and build
                        npm install
                        npm run build:test
                        echo "[Frontend] Frontend build completed successfully."

                        echo "[Frontend] Uploading artifacts to S3..."
                        # S3 bucket name
                        aws s3 cp output/dist/ s3://${S3_NAME} --recursive
                        aws s3 ls s3://${S3_NAME} --recursive --human-readable --summarize
                        aws s3 cp public/ s3://${S3_NAME}/public --recursive
                        aws s3 ls s3://${S3_NAME} --recursive --human-readable --summarize
                        echo "[Frontend] Artifact upload completed."

                        cd ..
                        cd $DIR
                        cd terraform/EC2-S3
                        export S3_URL=$(terraform output -raw s3_url)
                        echo "[Frontend] Distribution URL: $S3_URL"
                        echo "[Frontend] RDS endpoint: $ENDPOINT"
                        echo "[Frontend] Backend public IP: $BACKEND_PUBLIC_IP"
                        cd $DIR
                        rm -rf *
                        echo "[Frontend] Frontend deployment completed successfully."
                    '''
                }
            }
        }
        stage('Store Environment Name in DynamoDB') {
            steps {
                script {
                    def environmentName = env.NAME

                    withCredentials([
                        string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                    ]) {
                        sh "aws dynamodb put-item --table-name environments --region us-east-1 --item '{\"Name\": {\"S\": \"${environmentName}\"}}'"
                    }
                    echo "[DynamoDB] Stored environment name '${environmentName}'."
                }
            }
        }
    }
    post {
        always { 
            cleanWs()
        }
    }
}
